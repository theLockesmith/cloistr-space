@cloistr:registry=https://git.aegis-hq.xyz/api/v4/groups/9/-/packages/npm/

# pnpm builds under kaniko (no BuildKit cache mounts available), so every cold
# build links all 408 packages from an empty store. The default isolated linker
# creates a symlink farm that overlayfs handles very badly — a cold build was
# measured at ~35s/package, blowing past a 90m job timeout. Hoisted gives a flat
# node_modules (same shape npm produces in our other repos) and cuts the
# filesystem work dramatically.
node-linker=hoisted
